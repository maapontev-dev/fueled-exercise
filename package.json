{
  "name": "meridian",
  "version": "1.0.0",
  "description": "Project Description",
  "homepage": "https://project-domain.tld",
  "repository": {
    "type": "git",
    "url": "https://gitlab.10up.com/10up-internal/candidate-exercise"
  },
  "workspaces": [
    "themes/*"
  ],
  "scripts": {
    "setup": "npm install --omit=dev && composer setup",
    "setup:local": "npm install && composer setup:local",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run watch",
    "watch:theme": "npm run watch -w=meridian-theme",
    "watch": "npm run watch:theme",
    "lint-js": "npm run lint-js --workspaces --if-present",
    "format-js": "npm run format-js --workspaces --if-present",
    "lint-style": "npm run lint-style --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean-dist": "npm run clean-dist --workspaces --if-present",
    "clean": "rm -rf node_modules package-lock.json"
  },
  "author": {
    "name": "10up",
    "email": "info@10up.com",
    "url": "https://10up.com",
    "role": "developer"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "webpackbar": "^7.0.0"
  },
  "dependencies": {
    "@10up/block-components": "1.18.2",
    "@types/wordpress__block-editor": "11.5.13",
    "10up-toolkit": "^7.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@wordpress/create-block": "^4.100.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.3.3",
    "tar": "^7.4.3",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "5.3.3"
  }
}
