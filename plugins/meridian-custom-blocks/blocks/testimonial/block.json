{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "meridian/testimonial",
	"version": "1.0.0",
	"title": "Testimonial",
	"category": "widgets",
	"icon": "format-quote",
	"description": "Displays a selected published testimonial and its attribution.",
	"keywords": [
		"testimonial",
		"quote",
		"client"
	],
	"textdomain": "meridian-testimonial-block",
	"attributes": {
		"testimonialId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
